{
  "manifest_version": 3,
  "name": "APW Labels for ProShop (Unofficial)",
  "version": "0.7",
  "description": "One-click label previews for ProShop (Tools, COTS, Work Orders, Fixtures, Sequence Tags). Runs locally; no data collected.",

  "permissions": [],
  "host_permissions": [
    "https://*.adionsystems.com/*",
    "https://*.proshopcloud.com/*",
    "https://*.proshoperp.com/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://*.adionsystems.com/procnc/*",
        "https://*.proshopcloud.com/procnc/*",
        "https://*.proshoperp.com/procnc/*"
      ],
      "js": ["config.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
